# ここにはキー名だけを書く。値は .env（gitignore済み）か GitHub Secrets / Vercel の環境変数に置く。

# --- batch (Python) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role キー（旧形式 eyJ...）または secret キー（sb_secret_...）。絶対に公開しない
SUPABASE_SERVICE_KEY=
# フェーズ2で使用
DISCORD_WEBHOOK_URL=

# --- web (Next.js) ---  web/.env.local に置く
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# anon キー または publishable キー（sb_publishable_...）。RLSで保護される前提の公開用キー
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- フェーズ3（未設定ならその部分だけスキップ） ---
FRED_API_KEY=
EDINET_API_KEY=
# 通知に付けるダッシュボードのURL（秘密ではない。GitHub では Variables に登録）
DASHBOARD_URL=
